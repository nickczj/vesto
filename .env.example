APP_PORT=43000
APP_CONTAINER_PORT=3000
# Traefik reaches the app over the traefik network; keep this on loopback.
APP_BIND_IP=127.0.0.1
SHARED_DOCKER_NETWORK=vesto-shared
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
NUXT_DATABASE_PATH=/data/vesto-v2.db
# Local host-side development should use http://127.0.0.1:8080.
# Use shared Docker DNS only when vesto-v2 itself runs inside Docker on SHARED_DOCKER_NETWORK.
NUXT_VESTO_GO_BASE_URL=http://vesto-api:8080
# Required in production. /api/healthz stays public for the deploy health check.
NUXT_AUTH_USER=vesto
NUXT_AUTH_PASSWORD=change_me
# Consistent SQLite snapshots written by the backup service.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECS=86400
