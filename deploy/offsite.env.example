# Off-site backup configuration for the `offsite` compose service.
#
# On the NAS:
#   cp deploy/offsite.env.example ../.env.offsite
#   chmod 600 ../.env.offsite
# then fill in the values. The filled file is never committed and is not synced
# by the deploy workflow.
#
# The repository password is separate: it lives in deploy/restic-password
# (0600, the restic-password file mounted into the container). Keep a copy in
# the password manager. Without it the off-site copy cannot be restored.

# Cloudflare R2, S3-compatible. The bucket stays private.
# RESTIC_REPOSITORY=s3:https://<account_id>.r2.cloudflarestorage.com/vesto-backups

# R2 API token scoped to that one bucket, "Object Read & Write".
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# R2 accepts `auto` for the region.
# AWS_DEFAULT_REGION=auto

# Home Assistant webhook that receives every run result. Use the LAN address,
# not homeassistant.local: a container does not resolve mDNS.
# HA_VESTO_WEBHOOK=http://192.168.0.231:8123/api/webhook/<webhook_id>
